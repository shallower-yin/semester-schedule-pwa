{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "semester-schedule-pwa",
  "main": "workers/pwa/index.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "schedule.nfsg.eu.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/updates/stepenglish/*", "/android/*"]
  },
  "r2_buckets": [
    { "binding": "STEPENGLISH_RELEASES", "bucket_name": "stepenglish-releases" }
  ]
}
